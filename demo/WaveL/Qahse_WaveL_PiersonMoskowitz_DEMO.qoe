# =============================================================================
# Qahse.WaveL .qoe 波浪环境定义文件：Pierson-Moskowitz（JONSWAP gamma=1）
# =============================================================================

GENERATE	Mode	- 模式: {GENERATE=0; IMPORT=1; BATCH=2}
JONSWAP	FreqSpectrum	- 频谱模型: {NONE=0; REGULAR=1; JONSWAP=2; TORSETHAUGEN=3; OCHI_HUBBLE=4; USER_SPECTRUM=5; USER_TIMESERIES=6}
UNIDIRECTIONAL	DirSpectrum	- 方向扩展模型: {UNIDIRECTIONAL=0; COSINE_SPREAD=1}
EQUAL_ENERGY	Discretization	- 频率离散方式: {EQUAL_ENERGY=0; EQUAL_FREQUENCY=1}
EXTRAPOLATION	Stretching	- 自由液面以上运动学拉伸方法: {NONE=0; VERTICAL=1; EXTRAPOLATION=2; WHEELER=3}
4.0	Hs	- 有义波高 Hs (m)
11.0	Tp	- 峰值周期 Tp (s)
0.0	TimeOffset	- 波浪时间偏移量 (s)
0.0	DirMean	- 平均来波方向 (deg)
0.0	DirMax	- 方向扩展半宽 (deg)
2.0	DirSpreadExp	- cos^(2s) 方向扩展指数 s (-)
0.0	FCutIn	- 频谱截断下限频率 (Hz); 0 表示自动推导
0.0	FCutOut	- 频谱截断上限频率 (Hz); 0 表示自动推导
0.0	DfMax	- 单个频带允许的最大带宽 (Hz); 0 表示不额外切分
96	NumFreqBins	- 频率离散个数 (-)
1	NumDirBins	- 方向离散个数 (-)
20260508	RandomSeed	- 随机相位种子 (-)
1.0	Gamma	- JONSWAP 峰值增强因子 gamma; PM 谱取 1.0
0.0	Sigma1	- 峰值左侧谱宽参数 sigma1; AutoSigma=true 时自动推导
0.0	Sigma2	- 峰值右侧谱宽参数 sigma2; AutoSigma=true 时自动推导
false	AutoGamma	- 是否自动推导 gamma; PM 谱关闭自动推导
true	AutoSigma	- 是否自动推导 sigma1/sigma2
true	AutoFreqRange	- 是否自动推导频率范围
0.0	RegularPhase	- 规则波初始相位 (rad); 仅 REGULAR 有效
0.2	TimeStep	- 缓存与辅助输出的时间步长 (s)
120.0	SimDuration	- 缓存与辅助输出的总时长 (s)
80.0	WaterDepth	- 水深 d (m)
0.0	MCFDiameter	- MacCamy-Fuchs 修正圆柱直径 (m)
true	OutputComponents	- 是否输出辅助波浪分量文件 .wvc
true	OutputTimeSeries	- 是否输出辅助自由液面时程文件 .wts
false	OutputKinematicsGrid	- 是否输出诊断型 .vtu 运动学快照
./result/Qahse_WaveL_PiersonMoskowitz_DEMO.wfc	CachePath	- WaveL 主缓存文件 .wfc
./result/Qahse_WaveL_PiersonMoskowitz_DEMO.wfm	MetadataPath	- WaveL 主元数据文件 .wfm
./result/Qahse_WaveL_PiersonMoskowitz_DEMO.wvc	ComponentsPath	- 辅助波浪分量文件 .wvc 路径
./result/Qahse_WaveL_PiersonMoskowitz_DEMO.wts	TimeSeriesPath	- 辅助自由液面时程文件 .wts 路径
""	SummaryPath	- 辅助摘要文件 .wvm 路径；留空则不生成
1	GridNX	- x 方向缓存网格点数 (-)
1	GridNY	- y 方向缓存网格点数 (-)
12	GridNZ	- z 方向缓存网格点数 (-)
0.0	GridDX	- x 方向缓存网格间距 (m)
0.0	GridDY	- y 方向缓存网格间距 (m)
2.0	GridDZ	- z 方向缓存网格间距 (m)




